<div class="container">
<h1>Coach's Answer</h1>
<div class="card">
  <div class="card-body">
    <h2 class="card-title">Your question:</h2>
    <p class="card-text"><%= @question %></p>
    
    <h2 class="card-title">Coach's response:</h2>
    <p class="card-text"><strong><%= @answer %></strong></p>
    
    <%= link_to "Ask another question", ask_path, class: "btn btn-primary text-white" %>
  </div>
</div>
</div>